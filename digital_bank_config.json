      {
        "type": "pacs.002.001.10",
        "description": "Payment Status Report & Clearing Confirmation (إشعار المقاصة وتأكيد الحالة)",
        "format": "JSON Real-Time Webhook",
        "settlementRail": "Automated Switch Acknowledgement"
      },
      {
        "type": "camt.053.001.08",
        "description": "Bank-to-Customer Cash Statement & Ledger Report (كشف حساب وتسوية الأرصدة المصرفية)",
        "format": "JSON / CSV Stream",
        "settlementRail": "Daily & Real-Time EOD Reconciliation"
      },
      {
        "type": "pain.001.001.09",
        "description": "Customer Credit Transfer Initiation for Merchants (بدء دفعات متعددة للتجار والشركات)",
        "format": "Batch REST API",
        "settlementRail": "Multi-Vendor Payout Switch"
      }
    ]
  },
